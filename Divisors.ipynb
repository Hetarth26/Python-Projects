   "source": [
    "#Print a list of all the divisors of the number entered by the user\n",
    "\n",
    "Divisor_list =[]\n",
    "\n",
    "num = int(input(\"Please enter a number\"))\n",
    "\n",
    "for i in range(1,num):\n",
    "    if num%i == 0:\n",
    "        Divisor_list.append(i)\n",
    "        \n",
    "print(Divisor_list)"
   ]
