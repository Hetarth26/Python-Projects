    "# Write a function that takes a list and returns a new list that contains all the elements of the first list minus duplicates.\n",
    "\n",
    "def remove_duplicates():\n",
    "    names = [\"Michele\", \"Robin\", \"Sara\", \"Michele\", \"Sara\"]\n",
    "    names = set(names)\n",
    "    return(names)\n",
    "    \n",
    "remove_duplicates()"
